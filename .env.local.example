# ---------------------------------------------------------------------
# Supabase — 공개 읽기에 필요한 값은 아래 세 개다.
# 값은 Supabase Dashboard > Project Settings 에서 확인한다.
# ---------------------------------------------------------------------

# Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings > API Keys > Publishable key
# 신규 프로젝트는 sb_publishable_... 형식, 이전 프로젝트는 eyJ... 형식의 anon key 다.
# 이 사이트는 RLS 로 select 만 허용하므로 이 키가 노출돼도 쓰기가 불가능하다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 배포 주소. 메타데이터(canonical, Open Graph)에 쓰인다.
# 로컬은 http://localhost:7799, 배포 후에는 실제 도메인으로 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:7799

# ---------------------------------------------------------------------
# 관리자 기능(/admin, /api/admin/*)까지 로컬에서 돌릴 때만 아래 두 개를 넣는다.
# 읽기만 확인할 거면 없어도 된다.
#
# 배포 환경에서는 .env 가 아니라 Cloudflare Workers 시크릿으로 넣는다.
#   npx wrangler secret bulk secrets.json
#
# 주의: 두 값 모두 NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
#       붙이는 순간 클라이언트 번들에 박혀 브라우저로 노출된다.
# ---------------------------------------------------------------------

# 관리자 화면 로그인 키. 이 값이 새면 모든 문서를 수정·삭제할 수 있다.
# ADMIN_KEY=

# RLS 를 우회하는 DB 전권 키. 서버 API 에서만 쓰인다.
# SUPABASE_SERVICE_ROLE_KEY=
